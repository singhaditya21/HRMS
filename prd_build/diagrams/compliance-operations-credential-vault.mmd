flowchart TB
    classDef cust fill:#4a3a10,stroke:#a08020,color:#fff6dc,stroke-width:1px;
    classDef prod fill:#123a52,stroke:#1f6a94,color:#e8f6ff,stroke-width:1px;
    classDef vault fill:#35224a,stroke:#7a55a8,color:#f3eaff,stroke-width:2px;
    classDef ws fill:#0b3d2e,stroke:#0f5c46,color:#eafff5,stroke-width:1px;
    classDef gov fill:#5a1a1a,stroke:#a33,color:#ffecec,stroke-width:1px;
    classDef off fill:#2a2a2a,stroke:#777,color:#bbbbbb,stroke-width:1px,stroke-dasharray:3 3;

    subgraph EMP["Employer zone"]
        SIG["Authorised signatory:<br/>signs the written authority"]:::cust
        ADM["Employer admin:<br/>types the credential into the vault form"]:::cust
        OTPC["OTP contact:<br/>relays each OTP per session"]:::cust
    end

    subgraph PROD["Product zone - India region"]
        WAA["Written authority store"]:::prod
        GATE["Session gate:<br/>scope, mode, counsel fence, runbook version"]:::prod
        LOG["On-behalf log, hash-chained"]:::prod
    end

    subgraph VZ["Vault zone - separate keyspace"]
        VS["Encrypted entries,<br/>opaque handles only outside"]:::vault
        KMS["India-region KMS master key"]:::vault
        BRK["Injection broker"]:::vault
    end

    subgraph WS["Managed workspace"]
        OPR["Certified operator"]:::ws
        BR["Locked browser:<br/>no devtools, clipboard or capture"]:::ws
    end

    PORTAL["Government portal sign-in"]:::gov
    AI["AI layer and model gateway"]:::off
    BANK["Bank credentials, OTP seeds, DSC tokens,<br/>Aadhaar numbers - never held"]:::off

    SIG --> WAA
    ADM --> VS
    WAA --> GATE
    OPR --> GATE
    GATE -->|"check-out bound to one session"| BRK
    KMS --> BRK
    VS --> BRK
    BRK -->|"injects, never displays"| BR
    OPR --> BR
    BR --> PORTAL
    OTPC -->|"OTP through an authenticated prompt"| BR
    GATE --> LOG
    BR --> LOG
    VS x--x|"no network path"| AI
