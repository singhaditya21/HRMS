flowchart LR
    classDef hub fill:#0b3d2e,stroke:#0f5c46,color:#eafff5,stroke-width:2px;
    classDef sys fill:#123a52,stroke:#1f6a94,color:#e8f6ff,stroke-width:1px;
    classDef gov fill:#1d1a3a,stroke:#3b357a,color:#ecebff,stroke-width:1px;
    classDef op fill:#4a3a0b,stroke:#8a6d14,color:#fff6da,stroke-width:1px;
    classDef fb fill:#2a2a2a,stroke:#555,color:#f0f0f0,stroke-width:1px,stroke-dasharray:3 3;

    HUB{{"Integration layer<br/>queue · retry · idempotency key per submission<br/>reconciliation record · audit event"}}:::hub

    subgraph FIN["Money and accounts"]
        direction TB
        TALLY["Tally<br/>import for migration · accounting export"]:::sys
        BANK["Banks<br/>salary file per bank format<br/>bank-side maker-checker"]:::sys
    end

    subgraph DEV["Shop floor"]
        direction TB
        BIO["Attendance terminals<br/>ADMS / WDMS push"]:::sys
    end

    WB["Attended filing workbench<br/>operator under the employer's<br/>written authority to act"]:::op

    subgraph GOVT["Statutory portals: attended, no API"]
        direction TB
        EPFO["EPFO<br/>11-field ECR file · part-payment file<br/>interactive login with CAPTCHA"]:::gov
        ESIC["ESIC<br/>contribution template upload · challan"]:::gov
        TRACES["TRACES / Protean<br/>Form 138, ex-24Q: deductor runs FVU and uploads<br/>Form 130, ex-Form 16: generated by TRACES only"]:::gov
        PT["State PT portals<br/>per-state return and payment"]:::gov
    end

    subgraph HIRE["Talent inflow"]
        direction TB
        JOBS["Job boards<br/>inbound application sync only"]:::sys
    end

    TALLY -->|"guided import with mapping preview"| HUB
    HUB -->|"accounting export"| TALLY
    HUB -->|"salary file"| BANK
    BANK -.->|"per-beneficiary reject"| BANKFB["Retry per beneficiary<br/>run stays approved"]:::fb

    BIO -->|"punch packets to tenant-scoped URL"| HUB
    HUB -->|"two-phase template deletion"| BIO
    BIO -.->|"device offline"| BIOFB["Buffer and replay on reconnect"]:::fb

    HUB -->|"artefacts generated and validated locally"| WB
    WB -->|"operator uploads"| EPFO
    WB -->|"operator uploads"| ESIC
    WB -->|"deductor-side FVU run and upload"| TRACES
    WB -->|"operator files"| PT
    WB -.->|"portal down"| WBFB["Waits in attended queue against due date<br/>shows generated, awaiting portal"]:::fb
    EPFO -.->|"rejection error file"| WB

    JOBS -->|"applications"| HUB
