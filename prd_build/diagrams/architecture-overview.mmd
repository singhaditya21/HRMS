flowchart TB
    classDef client fill:#123a52,stroke:#1f6a94,color:#e8f6ff,stroke-width:1px;
    classDef gateway fill:#0b3d2e,stroke:#0f5c46,color:#eafff5,stroke-width:1px;
    classDef service fill:#1d1a3a,stroke:#3b357a,color:#ecebff,stroke-width:1px;
    classDef data fill:#2a2a2a,stroke:#555,color:#f0f0f0,stroke-width:1px;
    classDef integ fill:#4a3a0b,stroke:#8a6d14,color:#fff6da,stroke-width:1px;
    classDef ext fill:#5a1e1e,stroke:#8f2f2f,color:#ffecec,stroke-width:1px;

    subgraph CLIENTS["Clients"]
        C1["Web app<br/>(HR/admin/CA)"]:::client
        C2["Mobile app<br/>(employee ESS)"]:::client
        C3["Kiosk / biometric<br/>(shop-floor punch)"]:::client
    end

    GW{{"API gateway<br/>authN/Z · multi-tenant routing<br/>rate limit · audit tap · idempotency"}}:::gateway

    C1 --> GW
    C2 --> GW
    C3 --> GW

    subgraph SVC["Domain services"]
        S1["Core HR<br/>employee master · org · docs<br/>Aadhaar held only as an opaque token"]:::service
        S2["Payroll engine<br/>CTC · earnings/deductions · payslip<br/>bounded fixed-point nodes"]:::service
        S3["Attendance & leave<br/>shifts · musters · OT"]:::service
        S4["Statutory rules engine<br/>EPF/ESI/PT/LWF/TDS Form 138/gratuity<br/>pure: inputs + rule-set version + context"]:::service
        S5["AI orchestrator<br/>extract · reason · draft · route<br/>(assistive, maker-checker)"]:::service
        S6["Filing orchestrator<br/>filing state machine · filing ledger"]:::service
    end

    GW --> S1
    GW --> S2
    GW --> S3
    GW --> S5
    GW --> S6

    S3 --> S2
    S1 --> S2
    S2 <-->|"resolve rule versions"| S4
    S2 --> S6
    S5 -.->|reads context| S1
    S5 -.->|"drafts, via approval-gated write path"| S6

    subgraph DATA["Data stores — India region"]
        D1[("OLTP<br/>tenant-partitioned RDBMS")]:::data
        D2[("Doc/object store<br/>PDFs · challans · returns")]:::data
        D3[("Audit & event log<br/>immutable, append-only<br/>class-scoped erasure")]:::data
        D4[("Rules/versions store<br/>gazette-cited, bitemporal")]:::data
        D5[("Aadhaar token store<br/>separately encrypted<br/>separately access-controlled")]:::data
        D6[("Logs incl. tokenised LLM prompts<br/>at least 180 days in India")]:::data
    end

    S1 --> D1
    S1 --> D5
    S2 --> D1
    S3 --> D1
    S4 --> D4
    S2 --> D2
    S6 --> D2
    S5 --> D2
    GW --> D3
    S2 --> D3
    S6 --> D3
    S5 --> D6

    subgraph INTEG["Integration layer"]
        I1["Attended filing workbench<br/>EPFO ECR · ESIC · state PT · Form 138<br/>operator under employer authority"]:::integ
        I2["Bank salary files<br/>per-bank format · host-to-host where offered<br/>per-beneficiary reconciliation"]:::integ
        I3["Identifier validation<br/>local format checks: PAN · UAN · IFSC<br/>no Aadhaar verification service"]:::integ
        EG["Redaction egress gateway<br/>only path to model providers<br/>default-deny Aadhaar · PAN · bank · templates"]:::integ
    end

    S6 --> I1
    S2 --> I2
    S1 --> I3
    S5 -.->|"every model call"| EG

    subgraph EXT["External portals and rails, outside our boundary"]
        E1["EPFO / ESIC / State PT / LWF<br/>attended portals, no API"]:::ext
        E2["TRACES / Protean<br/>Form 138 upload · Form 130 generated by TRACES"]:::ext
        E3["Banks"]:::ext
    end

    I1 --> E1
    I1 --> E2
    I2 --> E3

    AI[["Model providers<br/>(swappable; Indic + premium tiers)<br/>per-tenant kill switch · consented set"]]:::service
    EG -.->|"redacted, tokenised prompts"| AI
