flowchart TB
    classDef q fill:#132b4a,stroke:#2f5f9e,color:#e3efff,stroke-width:1px;
    classDef yes fill:#0b5c3e,stroke:#17b37a,color:#eafff5,stroke-width:2px;
    classDef no fill:#3a3a3a,stroke:#6b6b6b,color:#f0f0f0,stroke-width:1px;
    classDef note fill:#f2f2f2,stroke:#6b6b6b,color:#111111,stroke-width:1px;

    S["<b>Person-period row</b><br/>one person, one legal entity,<br/>one billing period"]:::q
    Q1{"Did the person appear in a<br/>pay run for this entity<br/>in the period?"}:::q
    Q2{"Did the person appear in a<br/>statutory artefact or filing instance<br/>for this entity in the period?"}:::q
    Q3{"Was the person an active<br/>assignment for any part<br/>of the period?"}:::q
    Q4{"Is the person billable in<br/>another entity of the same tenant<br/>for the same period?"}:::q

    B["<b>BILLABLE</b><br/>prorate on the assignment days<br/>inside the period"]:::yes
    BF["<b>BILLABLE, full period</b><br/>a filed person is a billed person,<br/>even at zero net pay"]:::yes
    N1["<b>NOT BILLABLE</b><br/>record exists, no economic<br/>or statutory event"]:::no
    N2["<b>NOT BILLABLE in this entity</b><br/>counted once, in the entity<br/>that carries the assignment"]:::no

    S --> Q1
    Q1 -->|"yes"| Q4
    Q1 -->|"no"| Q2
    Q2 -->|"yes"| BF
    Q2 -->|"no"| Q3
    Q3 -->|"yes"| B
    Q3 -->|"no"| N1
    Q4 -->|"no"| B
    Q4 -->|"yes"| N2

    K["<b>Never a reason to exclude</b><br/>zero net pay, full-month loss of pay,<br/>suspension, notice period, archived record,<br/>an employee the tenant deleted after the run"]:::note
    L["<b>Never a reason to include</b><br/>candidates, ex-employees with no event,<br/>attendance-only persons on no payroll,<br/>a CA console user, a duplicate record<br/>merged during the period"]:::note

    BF -.- K
    N1 -.- L
