flowchart LR
    classDef phase fill:#d1e7dd,stroke:#146c43,color:#0a3622;
    classDef gate fill:#fff3cd,stroke:#997404,color:#5c4708;
    classDef fence fill:#f8d7da,stroke:#b02a37,color:#5c161c;
    classDef side fill:#e2e3e5,stroke:#6c757d,color:#343a40;

    M0["Month zero, outside the product<br/>start ISO 27001 - the one clock money cannot compress<br/>CERT-In duties apply from day one - EV-062"]:::side

    PRE{{"Pre-launch gate - before the first invoice<br/>each artefact passes the authority's own validation on real data<br/>attended-filing legality cleared by counsel - section 23<br/>SLA liability wording signed off"}}:::gate

    subgraph V1["v1 - Files the beachhead: 20-199 private, 10-19 as funnel<br/>files = portal-accepted artefact + attended submission, liability stays with the employer"]
