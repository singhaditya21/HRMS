  classDef acq fill:#fff3cd,stroke:#997404,color:#5c4708;
  classDef commit fill:#d1e7dd,stroke:#146c43,color:#0a3622;
  classDef expand fill:#cfe2ff,stroke:#0a58ca,color:#052c65;
