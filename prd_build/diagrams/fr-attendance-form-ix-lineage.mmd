flowchart TB
    subgraph ERASABLE["Erasable class - tombstoned when its retention class expires"]
        punch[("Punch store<br/>raw, source-tagged, payload_hash")]
    end
    punch --> pair["Pairing - FR-ATT-020<br/>skew-corrected, shift-start anchored,<br/>working-day cut-off where there is no roster"]
    pair --> sessions["Sessions per shift-day<br/>every IN and OUT kept"]
    sessions --> cell{"Cell state<br/>FR-ATT-033"}
    cell -->|"paired session"| paired["PAIRED<br/>render per form_ix_multi_session_render,<br/>all sessions stored"]
